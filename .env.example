# ===== 動作モード =====
# local: GCP不要。ダミー素材で全工程を体験できる(動作確認用)
# cloud: GCP本番。Vertex AI / Firestore / GCS / YouTube を使用
APP_MODE=local

# ===== ローカルモード =====
DATA_DIR=data

# ===== クラウドモード(GCP) =====
GCP_PROJECT=
GCP_REGION=asia-northeast1
GCS_BUCKET=
# 承認UIへのアクセスを許可するGoogleアカウント(カンマ区切り)
ALLOWED_EMAILS=matsunaga@nexspace.jp

# ===== モデル設定(実装時点の安定版。変更可) =====
GEMINI_MODEL=gemini-2.5-flash
IMAGEN_MODEL=imagen-3.0-generate-002
VEO_MODEL=veo-3.0-generate-001
LYRIA_MODEL=lyria-002
TTS_VOICE=ja-JP-Neural2-B

# ===== コスト管理 =====
# 1案件あたりの既定上限(円)。超過が予測されると生成を停止して承認を求める
DEFAULT_COST_LIMIT_JPY=1500
# 単価表の上書き(JSON)。省略時は app/costs.py の既定値
# COST_TABLE_JSON={"veo_second": 60.0}

# ===== 投稿サービス(分離デプロイ) =====
UPLOADER_URL=
# YouTube OAuth(投稿サービス側でのみ使用。Secret Manager経由を推奨)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
